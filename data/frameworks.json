{
  "schema": "mcp-mirror/agents@1",
  "updated": "2026-09-18",
  "mcp_spec": "2025-11-25",
  "repo": "https://github.com/thierrypdamiba/mcp-mirror",
  "_shape": "Mirrors the caniuse data model. Agents (their browsers) carry a version_list with an era index and a release date, and capability files carry stats as a version to support-code map. Era 0 is the release we measured, negative is older, positive is newer. Versions with no entry in a capability's stats render as not yet measured.",
  "statuses": {
    "stable": {
      "short": "MCP 2025-11-25",
      "label": "Defined in the released MCP specification"
    },
    "draft": {
      "short": "MCP draft",
      "label": "Defined only in a draft revision of the MCP specification"
    },
    "proposed": {
      "short": "proposed",
      "label": "Proposed, not yet in any published specification"
    },
    "deprecated": {
      "short": "deprecated",
      "label": "Defined in the released MCP specification but deprecated in this revision, and scheduled for removal in a later one"
    }
  },
  "support_codes": {
    "y": "present at the declared capture boundary",
    "a": "changed at the boundary or retained elsewhere",
    "n": "dropped during adaptation",
    "u": "not yet measured"
  },
  "defaults": {
    "inclusion_rule": "A framework is listed if it ships a first-party or officially documented MCP adapter. Nothing is excluded on quality grounds.",
    "order_rule": "Alphabetical within language group. No ranking is implied or computed.",
    "version_policy": "Era 0 is the release actually measured. Surrounding releases come from the package registry (PyPI, npm) and are shown as not yet measured until a scan covers them.",
    "green_rule": "A cell is 'y' only if the value is present in the tool definition at that framework's declared capture boundary. Nothing else counts.",
    "partial_rule": "'a' means the capability is not present unchanged: the note must say whether it was transformed at the boundary, only partly preserved, or retained elsewhere by the framework.",
    "note_rule": "Every 'a' and 'n' cell must carry a #n note reference naming the exact mechanism, so a status can be checked rather than trusted.",
    "usage_rule": "No adoption weighting is published. We have no defensible source yet, and an invented percentage would be the least trustworthy number on the page."
  },
